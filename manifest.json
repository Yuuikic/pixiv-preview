{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.pixiv.net/*", "https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*", "https://www.pixivision.net/*", "https://pixivision.net/*"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.pixiv.net/*"],
      "js": ["src/settings.js", "src/i18n.js", "src/content.js"],
      "css": ["src/preview.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["src/settings.js", "src/i18n.js", "src/link-submit.js", "src/twitter.js"],
      "css": ["src/link-submit.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.pixivision.net/*", "https://pixivision.net/*"],
      "js": ["src/settings.js", "src/i18n.js", "src/link-submit.js", "src/pixivision.js"],
      "css": ["src/link-submit.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/nazurin-48.png"],
      "matches": ["https://www.pixiv.net/*"]
    }
  ]
}
