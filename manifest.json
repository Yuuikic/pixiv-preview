{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.pixiv.net/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://www.pixivision.net/*",
    "https://pixivision.net/*",
    "https://yande.re/*",
    "https://www.yande.re/*",
    "https://konachan.com/*",
    "https://www.konachan.com/*",
    "https://konachan.net/*",
    "https://www.konachan.net/*",
    "https://lolibooru.moe/*",
    "https://www.lolibooru.moe/*",
    "https://danbooru.donmai.us/*",
    "https://safebooru.donmai.us/*",
    "https://zerochan.net/*",
    "https://www.zerochan.net/*",
    "https://gelbooru.com/*",
    "https://www.gelbooru.com/*",
    "https://wallhaven.cc/*",
    "https://www.wallhaven.cc/*",
    "https://whvn.cc/*",
    "https://bilibili.com/*",
    "https://www.bilibili.com/*",
    "https://t.bilibili.com/*",
    "https://weibo.com/*",
    "https://www.weibo.com/*",
    "https://m.weibo.com/*",
    "https://weibo.cn/*",
    "https://www.weibo.cn/*",
    "https://m.weibo.cn/*",
    "https://share.api.weibo.cn/*",
    "https://kemono.party/*",
    "https://kemono.su/*",
    "https://kemono.cr/*",
    "https://telegra.ph/*",
    "https://graph.org/*",
    "https://bsky.app/*",
    "https://*.artstation.com/*",
    "https://*.deviantart.com/*",
    "https://*.lofter.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.pixiv.net/*"
      ],
      "js": [
        "src/settings.js",
        "src/i18n.js",
        "src/content.js"
      ],
      "css": [
        "src/preview.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/i18n.js",
        "src/link-submit.js",
        "src/twitter.js"
      ],
      "css": [
        "src/link-submit.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.pixivision.net/*",
        "https://pixivision.net/*"
      ],
      "js": [
        "src/settings.js",
        "src/i18n.js",
        "src/link-submit.js",
        "src/pixivision.js"
      ],
      "css": [
        "src/link-submit.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://yande.re/*",
        "https://www.yande.re/*",
        "https://konachan.com/*",
        "https://www.konachan.com/*",
        "https://konachan.net/*",
        "https://www.konachan.net/*",
        "https://lolibooru.moe/*",
        "https://www.lolibooru.moe/*",
        "https://danbooru.donmai.us/*",
        "https://safebooru.donmai.us/*",
        "https://zerochan.net/*",
        "https://www.zerochan.net/*",
        "https://gelbooru.com/*",
        "https://www.gelbooru.com/*",
        "https://wallhaven.cc/*",
        "https://www.wallhaven.cc/*",
        "https://whvn.cc/*",
        "https://bilibili.com/*",
        "https://www.bilibili.com/*",
        "https://t.bilibili.com/*",
        "https://weibo.com/*",
        "https://www.weibo.com/*",
        "https://m.weibo.com/*",
        "https://weibo.cn/*",
        "https://www.weibo.cn/*",
        "https://m.weibo.cn/*",
        "https://share.api.weibo.cn/*",
        "https://kemono.party/*",
        "https://kemono.su/*",
        "https://kemono.cr/*",
        "https://telegra.ph/*",
        "https://graph.org/*",
        "https://bsky.app/*",
        "https://*.artstation.com/*",
        "https://*.deviantart.com/*",
        "https://*.lofter.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/i18n.js",
        "src/nazurin-sites.js",
        "src/link-submit.js",
        "src/generic-submit.js"
      ],
      "css": [
        "src/link-submit.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/nazurin-48.png"
      ],
      "matches": [
        "https://www.pixiv.net/*"
      ]
    }
  ]
}
